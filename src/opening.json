{"passages": [{"id": "title", "tibetan": "༄༅། ། རྫོགས་པ་ཆེན་པོ་ཀློང་ཆེན་སྙིང་ཏིག་གི་སྔོན་འགྲོའི་ཁྲིད་ཡིག་ཀུན་བཟང་བླ་མའི་ཞལ་ལུང་ཞེས་བྱ་བ་བཞུགས་སོ། །", "lines": [{"tibetan": "རྫོགས་པ་ཆེན་པོ་ཀློང་ཆེན་སྙིང་ཏིག་གི་སྔོན་འགྲོའི་ཁྲིད་ཡིག་ཀུན་བཟང་བླ་མའི་ཞལ་ལུང་ཞེས་བྱ་བ་བཞུགས་སོ", "wylie": "rdzogs pa chen po klong chen snying tig gi sngon 'gro'i khrid yig kun bzang bla ma'i zhal lung zhes bya ba bzhugs so", "syllables": ["རྫོགས", "པ", "ཆེན", "པོ", "ཀློང", "ཆེན", "སྙིང", "ཏིག", "གི", "སྔོན", "འགྲོའི", "ཁྲིད", "ཡིག", "ཀུན", "བཟང", "བླ", "མའི", "ཞལ", "ལུང", "ཞེས", "བྱ", "བ", "བཞུགས", "སོ"], "audio": "title-L1"}], "reviewStatus": "draft", "source": {"text": "普贤上师言教（索达吉堪布译，德钦·曲美多吉编排藏汉对照版）", "pdfPage": 1}, "audio": "title"}, {"id": "homage", "tibetan": "༄༅། །རྗེ་བཙུན་བླ་མ་དམིགས་པ་མེད་པའི་ཐུགས་རྗེ་ཆེན་པོ་དང་ལྡན་པ་རྣམས་ལ་ཕྱག་འཚལ་ལོ། །", "lines": [{"tibetan": "རྗེ་བཙུན་བླ་མ་དམིགས་པ་མེད་པའི་ཐུགས་རྗེ་ཆེན་པོ་དང་ལྡན་པ་རྣམས་ལ་ཕྱག་འཚལ་ལོ", "wylie": "rje btsun bla ma dmigs pa med pa'i thugs rje chen po dang ldan pa rnams la phyag 'tshal lo", "syllables": ["རྗེ", "བཙུན", "བླ", "མ", "དམིགས", "པ", "མེད", "པའི", "ཐུགས", "རྗེ", "ཆེན", "པོ", "དང", "ལྡན", "པ", "རྣམས", "ལ", "ཕྱག", "འཚལ", "ལོ"], "audio": "homage-L1"}], "reviewStatus": "draft", "source": {"text": "普贤上师言教（索达吉堪布译，德钦·曲美多吉编排藏汉对照版）", "pdfPage": 1}, "audio": "homage"}, {"id": "verse-1", "tibetan": "རྒྱལ་བའི་དགོངས་པ་རིག་འཛིན་བརྡའ་ཡིས་བརྒྱུད། །གང་ཟག་མི་ལས་སྐལ་པ་རབ་གྱུར་པས། །དམ་པའི་རྗེས་ཟིན་དོན་གཉིས་མཐར་ཕྱིན་པ། །བརྒྱུད་གསུམ་བླ་མ་རྣམས་ལ་ཕྱག་འཚལ་ལོ། །", "lines": [{"tibetan": "རྒྱལ་བའི་དགོངས་པ་རིག་འཛིན་བརྡའ་ཡིས་བརྒྱུད", "wylie": "rgyal ba'i dgongs pa rig 'dzin brda' yis brgyud", "syllables": ["རྒྱལ", "བའི", "དགོངས", "པ", "རིག", "འཛིན", "བརྡའ", "ཡིས", "བརྒྱུད"], "audio": "verse-1-L1"}, {"tibetan": "གང་ཟག་མི་ལས་སྐལ་པ་རབ་གྱུར་པས", "wylie": "gang zag mi las skal pa rab gyur pas", "syllables": ["གང", "ཟག", "མི", "ལས", "སྐལ", "པ", "རབ", "གྱུར", "པས"], "audio": "verse-1-L2"}, {"tibetan": "དམ་པའི་རྗེས་ཟིན་དོན་གཉིས་མཐར་ཕྱིན་པ", "wylie": "dam pa'i rjes zin